[preset00]
// Bass Bounce -- zoom punches on the beat, rot flips direction on strong hits, colours snap with treble.
fRating=4.0
fDecay=0.96
zoom=1.0
rot=0.0
warp=0.2
cx=0.5
cy=0.5
wave_r=0.9
wave_g=0.3
wave_b=0.2
per_frame_init_1=q1 = 1; q2 = 0;
per_frame_1=q1 = q1*0.88 + bass*0.12;
per_frame_2=q2 = if(above(bass,1.35), -q2 + if(equal(q2,0),1,0), q2);
per_frame_3=zoom = 1.0 + 0.16*pow(max(0,bass-0.9),2);
per_frame_4=rot = 0.02*if(equal(q2,0),1,q2)*sin(time*0.9) + 0.015*(q1-1);
per_frame_5=warp = 0.2 + 0.5*max(0,bass-1.1);
per_frame_6=wave_r = 0.55 + 0.45*sin(time*1.3);
per_frame_7=wave_g = 0.35 + 0.35*sin(time*1.1 + 2.0) + 0.15*(treb-1);
per_frame_8=wave_b = 0.35 + 0.30*sin(time*0.7 + 4.0);
per_frame_9=cx = 0.5 + 0.10*sin(time*0.6)*q1;
per_frame_10=cy = 0.5 + 0.10*cos(time*0.5)*q1;
