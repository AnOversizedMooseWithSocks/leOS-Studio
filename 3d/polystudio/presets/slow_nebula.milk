[preset00]
// Slow Nebula -- near-static drift, deep slow hue rotation, mid-band shimmer. The ambient one.
fRating=4.0
fDecay=0.995
zoom=1.0
rot=0.0
warp=0.08
cx=0.5
cy=0.5
wave_r=0.4
wave_g=0.45
wave_b=0.7
per_frame_init_1=q1 = 1;
per_frame_1=q1 = q1*0.97 + mid*0.03;
per_frame_2=zoom = 1.0 + 0.015*sin(time*0.11);
per_frame_3=rot = 0.0028*sin(time*0.07) + 0.002*(q1-1);
per_frame_4=warp = 0.08 + 0.06*sin(time*0.19);
per_frame_5=wave_r = 0.42 + 0.20*sin(time*0.13);
per_frame_6=wave_g = 0.42 + 0.20*sin(time*0.13 + 2.09);
per_frame_7=wave_b = 0.55 + 0.25*sin(time*0.13 + 4.18);
per_frame_8=cx = 0.5 + 0.03*sin(time*0.05);
per_frame_9=cy = 0.5 + 0.03*cos(time*0.04);
